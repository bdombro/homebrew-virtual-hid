set -euo pipefail

/bin/cat <<'SETUP_INSTRUCTIONS'
@DRIVER_SETUP_INSTRUCTIONS@
SETUP_INSTRUCTIONS

label=com.bdombro.macos-input.driver
official_label=org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon
service_file="/Library/LaunchDaemons/$label.plist"
daemon='/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Daemon'
socket='/Library/Application Support/org.pqrs/tmp/rootonly/karabiner_virtual_hid_device_service.sock'
package_id=org.pqrs.Karabiner-DriverKit-VirtualHIDDevice
cask=bdombro/macos-input/karabiner-driverkit-virtualhiddevice

manual_steps() {
    /bin/cat <<'MANUAL_STEPS'
Still required, as your normal GUI user:
  1. Run:
       /Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager activate
  2. Approve the driver in the macOS prompts/System Settings.
  3. Restart if macOS requests it; the managed daemon starts at boot.

Live input affects the focused app and requires sudo.
No keyboard/mouse input is sent by this setup command.
MANUAL_STEPS
}

/bin/cat <<'PLAN'

Automatic setup will:
  - If the driver is missing, run Homebrew as your normal user:
      brew install --cask bdombro/macos-input/karabiner-driverkit-virtualhiddevice
    The cask pins v8.8.0. Homebrew downloads/verifies the package and runs
    macOS Installer, requesting administrator authentication as needed.
    A different installed version will NOT be overwritten or downgraded.
  - Reuse the official Karabiner launchd service if it exists. Otherwise,
    configure our own root daemon using:
      /usr/bin/sudo -v
      sudo /usr/bin/install -o root -g wheel -m 0644 <service-plist> /Library/LaunchDaemons/com.bdombro.macos-input.driver.plist
      sudo /bin/launchctl bootstrap system /Library/LaunchDaemons/com.bdombro.macos-input.driver.plist
    The plist runs the installed Karabiner daemon at boot and keeps it alive.
    A loaded service is started with launchctl kickstart if not already running.
    A daemon running outside these recognized services must be stopped manually.
  - Verify that launchd loaded the service and remove temporary downloads.
PLAN
manual_steps

if [[ "$1" == --dry-run ]]; then
    printf '\nDry run: nothing changed; no sudo or download was attempted.\n'
    exit 0
fi
if [[ "$1" != --install ]]; then
    printf '\nRun macos-input driver-install in an interactive terminal.\n' >&2
    exit 1
fi
printf '\nProceed with automatic setup? [y/N] '
if ! IFS= read -r answer; then
    printf '\nCannot read confirmation; nothing changed.\n' >&2
    exit 1
fi
if [[ "$answer" != y && "$answer" != Y && "$answer" != yes && "$answer" != YES ]]; then
    printf 'Cancelled; nothing changed.\n'
    exit 0
fi
if [[ ! -t 0 ]]; then
    printf 'Confirmation must come from an interactive terminal; nothing changed.\n' >&2
    exit 1
fi

work="$(/usr/bin/mktemp -d /private/tmp/macos-input-driver.XXXXXX)"
cleanup() {
    status=$?
    if ! /bin/rm -f -- "$work/service.plist" "$work/status"; then
        printf 'Cannot remove temporary setup files in %s\n' "$work" >&2
        status=1
    elif ! /bin/rmdir -- "$work"; then
        printf 'Cannot remove temporary setup directory %s\n' "$work" >&2
        status=1
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
trap 'printf "Driver setup failed; completed installation steps are not rolled back.\n" >&2' ERR

verify_driver() {
    local version
    version="$(/usr/sbin/pkgutil --pkg-info "$package_id" | /usr/bin/awk '$1 == "version:" { print $2 }')"
    if [[ "$version" != 8.8.0 ]]; then
        printf 'Expected driver v8.8.0; found version %s. Refusing to replace or use it.\n' "$version" >&2
        exit 1
    fi
    if [[ ! -x "$daemon" ]]; then
        printf 'The v8.8.0 receipt exists but its daemon is missing. Repair the driver manually.\n' >&2
        exit 1
    fi
}

receipts="$(/usr/sbin/pkgutil --pkgs)"
if printf '%s\n' "$receipts" | /usr/bin/grep -Fx "$package_id" >/dev/null; then
    verify_driver
    printf 'Driver v8.8.0 is already installed; leaving its files unchanged.\n'
else
    if [[ -e "$daemon" || -e /Applications/.Karabiner-VirtualHIDDevice-Manager.app ]]; then
        printf 'Unrecognized driver installation found; refusing to overwrite it.\n' >&2
        exit 1
    fi
    if [[ "$EUID" == 0 ]]; then
        printf 'Run macos-input driver-install without sudo; Homebrew requests administrator access when needed.\n' >&2
        exit 1
    fi
    if ! command -v brew >/dev/null; then
        printf 'Homebrew is required to install the driver cask. Install Homebrew or follow the manual package instructions above.\n' >&2
        exit 1
    fi
    brew install --cask "$cask"
    verify_driver
fi
/usr/bin/sudo -v

service_loaded() {
    if /usr/bin/sudo /bin/launchctl print "system/$1" >"$work/status" 2>&1; then
        return 0
    else
        result=$?
        if [[ "$result" != 113 ]]; then
            /bin/cat "$work/status" >&2
            exit "$result"
        fi
        return 1
    fi
}

if service_loaded "$official_label"; then
    label="$official_label"
    printf 'Reusing the official Karabiner launchd service.\n'
    if ! /usr/bin/grep -Fq 'state = running' "$work/status"; then
        /usr/bin/sudo /bin/launchctl kickstart "system/$label"
    fi
elif service_loaded "$label"; then
    printf 'Our driver service is already loaded.\n'
    if ! /usr/bin/grep -Fq 'state = running' "$work/status"; then
        /usr/bin/sudo /bin/launchctl kickstart "system/$label"
    fi
else
    if /usr/bin/sudo /bin/test -S "$socket"; then
        printf 'An unmanaged daemon socket exists. Stop that daemon (or investigate a stale socket) before retrying.\n' >&2
        exit 1
    fi
    /bin/cat >"$work/service.plist" <<SERVICE_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
SERVICE_PLIST
    if [[ -e "$service_file" || -L "$service_file" ]]; then
        if [[ -L "$service_file" ]] || ! /usr/bin/cmp -s "$work/service.plist" "$service_file"; then
            printf 'An unexpected service plist exists at %s; refusing to replace it.\n' "$service_file" >&2
            exit 1
        fi
    else
        /usr/bin/sudo /usr/bin/install -o root -g wheel -m 0644 "$work/service.plist" "$service_file"
    fi
    /usr/bin/sudo /bin/launchctl bootstrap system "$service_file"
fi
/usr/bin/sudo /bin/launchctl print "system/$label" >"$work/status"
printf '\nDone: driver files are installed and launchd has loaded the daemon service.\n'
printf 'Driver activation/approval has NOT been verified or bypassed.\n\n'
manual_steps
